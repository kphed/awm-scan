{
  "name": "awm-scan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/extractSourceMetadata.ts && bun scripts/indexEvents.ts && bun scripts/copyEventSnapshot.ts && next build",
    "start": "next start",
    "lint": "tsc -p ./tsconfig.lint.json --noEmit && bunx eslint 'src/**/*.{ts,tsx}' && bunx prettier 'src/**/*.{ts,tsx}' --check",
    "format": "bunx prettier 'src/**/*.{ts,tsx}' --write",
    "test": "bun test",
    "contracts:source-metadata": "bun scripts/extractSourceMetadata.ts",
    "index:events": "bun scripts/indexEvents.ts",
    "test:e2e": "bunx playwright test",
    "test:e2e:accept": "bunx playwright test --update-snapshots",
    "test:e2e:update": "bun run test:e2e:accept && bun run test:e2e"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "viem": "^2.47.10",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@solidity-parser/parser": "^0.20.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prettier": "^3.8.1",
    "shiki": "^4.0.2",
    "typescript": "^5"
  }
}
